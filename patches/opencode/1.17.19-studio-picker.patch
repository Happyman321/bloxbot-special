+      serverName: string,
+      toolName: "list_roblox_studios" | "set_active_studio",
+      args: Record<string, unknown>,
+    ) {
+      const status = yield* mcp.status()
+      if (!(serverName in status)) {
+        return yield* new McpServerNotFoundError({
+          name: serverName,
+          message: `MCP server not found: ${serverName}`,
+        })
+      }
+
+      const entry = (yield* mcp.tools())[McpCatalog.toolName(serverName, toolName)]
+      if (!entry) {
+        return yield* new ServiceUnavailableError({
+          service: serverName,
+          message: `MCP server ${serverName} is not connected or does not expose ${toolName}`,
+        })
+      }
+
+      const result = yield* Effect.tryPromise({
+        try: () =>
+          entry.client.callTool({ name: toolName, arguments: args }, CallToolResultSchema, {
+            resetTimeoutOnProgress: true,
+            timeout: entry.timeout,
+            onprogress: () => {},
+          }),
+        catch: (error) =>
+          new UpstreamError({
+            service: serverName,
+            message: error instanceof Error ? error.message : String(error),
+          }),
+      })
+
+      if (result.isError) {
+        const message = result.content
+          .flatMap((item) => (item.type === "text" ? [item.text] : []))
+          .filter((text) => text.trim())
+          .join("\n\n")
+        return yield* new UpstreamError({
+          service: serverName,
+          message: message || `${toolName} returned an error`,
+        })
+      }
+
+      return {
+        content: result.content,
+        ...(result.structuredContent === undefined ? {} : { structuredContent: result.structuredContent }),
+        ...(result.isError === undefined ? {} : { isError: result.isError }),
+      }
+    })
+
