+
+    const activeStudio = Effect.fn("McpHttpApi.activeStudio")(function* (ctx: {
+      params: { name: string }
+      payload: typeof SetActiveStudioPayload.Type
+    }) {
+      return yield* callStudioTool(ctx.params.name, "set_active_studio", { studio_id: ctx.payload.studioId })
+    })
+
